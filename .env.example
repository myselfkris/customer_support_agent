# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (required for RAG pipeline - Skill 3)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/customer_support

# Optional: run fully offline with deterministic keyword-rule mocks (no API calls).
# Set to "true" for development/testing without a valid API key or to avoid rate limits.
MOCK_MODE=false

# Auth (Chunk 5): secret used to sign admin JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_here
